{
  "manifest_version": 3,
  "name": "인벤 다크 모드 (비공식)",
  "version": "0.2.3",
  "description": "인벤(inven.co.kr)에서만 동작하는 다크 모드. 다른 사이트에는 영향 없음, 정보 수집 없음.",
  "permissions": [
    "storage"
  ],
  "icons": {
    "16": "icons/16.png",
    "32": "icons/32.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  },
  "action": {
    "default_popup": "src/popup.html",
    "default_icon": {
      "16": "icons/16.png",
      "32": "icons/32.png",
      "48": "icons/48.png",
      "128": "icons/128.png"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "*://*.inven.co.kr/*",
        "*://inven.co.kr/*"
      ],
      "css": [
        "src/dark.css"
      ],
      "js": [
        "src/mode.js",
        "src/content.js"
      ],
      "run_at": "document_start",
      "all_frames": false
    }
  ]
}
